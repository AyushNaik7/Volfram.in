# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/volfram
# For MongoDB Atlas use format:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/volfram?retryWrites=true&w=majority

# JWT Secret - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
# OR use Groq (free): https://console.groq.com/keys (key starts with gsk_)
OPENAI_API_KEY=your-openai-or-groq-api-key-here

# Supabase Configuration (Optional - for conversation history)
# If not provided, chatbot will work in simplified mode without history
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key

# Email Configuration (for nodemailer)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-app-password
